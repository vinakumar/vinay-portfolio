{
  "name": "vinay-portfolio",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 127.0.0.1",
    "prebuild": "node static-tools.mjs check",
    "build": "ng build && node static-tools.mjs finalize",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:tooling": "node --test static-tools.test.mjs",
    "test:e2e": "playwright test",
    "preview": "node static-tools.mjs serve",
    "release:check": "node static-tools.mjs release",
    "social:render": "node static-tools.mjs social",
    "lint": "ng lint",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json && tsc --noEmit -p tsconfig.e2e.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run test:tooling && npm run build && npm run test:e2e"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": "^24.15.0",
    "npm": ">=10 <13"
  },
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "overrides": {
    "minimatch": "11.0.3"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@angular/platform-server": "22.2.4",
    "@angular/ssr": "22.2.5",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "angular-eslint": "22.6.0",
    "eslint": "10.14.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.5"
  }
}
